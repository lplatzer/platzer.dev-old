# WorkOS Authentication Configuration
# Copy this file to .env.local and fill in your actual values

# WorkOS Client ID (from your WorkOS dashboard)
# Example: client_01K7BXJHEC2QJCMJF9F8ESWTHJ
WORKOS_CLIENT_ID=your_workos_client_id_here

# WorkOS API Key (from your WorkOS dashboard)
# Use staging key (sk_test_...) for development, production key for prod
WORKOS_API_KEY=your_workos_api_key_here

# WorkOS Cookie Password (must be at least 32 characters)
# Generate a secure random string for this value
# Example: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=your_secure_cookie_password_at_least_32_chars_long

# WorkOS Redirect URI (OAuth callback URL)
# For local development: http://localhost:3000/callback
# For production: https://yourdomain.com/callback
WORKOS_REDIRECT_URI=http://localhost:3000/callback

# ============================================
# Setup Instructions:
# ============================================
# 1. Sign up for WorkOS: https://workos.com
# 2. Create a new application in the WorkOS dashboard
# 3. Copy your Client ID and API Key
# 4. Generate a secure random string for WORKOS_COOKIE_PASSWORD:
#    openssl rand -base64 32
# 5. Configure the redirect URI in WorkOS dashboard:
#    - Development: http://localhost:3000/callback
#    - Production: https://yourdomain.com/callback
# 6. Rename this file to .env.local
# 7. Fill in your actual values
# 8. Restart your development server
#
# ============================================
# Protected Routes:
# ============================================
# - /tools/digital-wishlist/edit - Requires authentication
#
# Public Routes:
# - /tools/digital-wishlist - Public (view wishlist)
# - All other routes - Public by default
